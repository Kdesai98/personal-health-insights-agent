{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krunal-health.local/schemas/bloom/feedback-event.schema.json",
  "title": "FeedbackEvent",
  "type": "object",
  "required": ["date", "action_id"],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "action_id": {
      "type": "string"
    },
    "adhered": {
      "type": ["boolean", "null"]
    },
    "reward": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "boolean", "null"]
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
